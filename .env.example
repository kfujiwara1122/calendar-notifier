# ==============================================================
# calendar-notifier 環境変数テンプレート
# このファイルをコピーして .env を作成し、実際の値を設定してください。
# NEVER commit .env to version control.
# ==============================================================

# --- GCP ---
GCP_PROJECT=your-gcp-project-id
GCP_LINE_NOTIFIER_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/line_notifier

# --- Google Calendar ---
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com

# --- LINE ---
LINE_GROUP_ID=your-line-group-id
# weekly_playground_suggester で直接使用（Cloud Functions では Secret Manager 経由）
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# --- Anthropic (weekly_playground_suggester) ---
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- ローカル開発専用（Cloud Functions 環境では不要）---
GCP_SERVICE_ACCOUNT_INFO_FILE=/path/to/service-account.json
LINE_CHANNEL_ACCESS_TOKEN_FILE=/path/to/line_channel_access_token
